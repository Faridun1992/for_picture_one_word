[mysqld]
# === InnoDB Engine ===

# Основной кеш данных и индексов — ~60% от RAM контейнера (5120 MB)
innodb_buffer_pool_size = 2560M
innodb_buffer_pool_instances = 2

# Redo-лог — влияет на скорость записи и crash recovery
innodb_redo_log_capacity = 1073741824

# Буфер лога в памяти — снижает I/O при пачках транзакций
innodb_log_buffer_size = 64M

# I/O capacity — настроить под тип диска (SSD: 1000-2000, HDD: 200-400)
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# Flush method — оптимально для Linux
innodb_flush_method = O_DIRECT

# Strict ACID — защита от потери данных при краше
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1

# Adaptive hash index — ускоряет повторяющиеся запросы
innodb_adaptive_hash_index = ON

# Change buffer — ускоряет DML на secondary indexes
innodb_change_buffering = all

# === Connections ===

# PHP-FPM 20 воркера + supervisor (Horizon) + запас
max_connections = 60

# Thread cache — снижает overhead создания потоков
thread_cache_size = 16

# === Query Performance ===

# Буферы (per-connection)
sort_buffer_size = 2M
read_rnd_buffer_size = 2M
join_buffer_size = 2M

# Temporary tables
tmp_table_size = 64M
max_heap_table_size = 64M

# Table cache
table_open_cache = 4000
table_definition_cache = 2000

# === Logging ===

# Slow queries — логировать всё дольше 1 сек
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1
log_queries_not_using_indexes = 1
log_throttle_queries_not_using_indexes = 10

# General log OFF in prod (только для отладки)
general_log = 0

# Error log
log_error = /var/lib/mysql/error.log
log_error_verbosity = 2

# === Character Set ===
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# === Security ===

# Запретить LOAD DATA LOCAL
local_infile = 0

# Запретить символические ссылки
symbolic-links = 0

# Таймаут неактивных соединений (10 мин)
wait_timeout = 600
interactive_timeout = 600
