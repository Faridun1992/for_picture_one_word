[mysqld]
# InnoDB buffer pool — основной кеш данных и индексов.
# MySQL контейнер: mem_limit 1792 MB. 1024 MB buffer pool + ~400 MB
# на connections/buffers/tmp-таблицы + ~200 MB overhead → укладываемся.
innodb_buffer_pool_size = 1024M
innodb_buffer_pool_instances = 2

# Размер redo-лога InnoDB — влияет на скорость записи и crash recovery
innodb_redo_log_capacity = 536870912

# Буфер лога в памяти — сбрасывается на диск раз в секунду или при commit
innodb_log_buffer_size = 32M

# Максимум одновременных соединений:
# PHP-FPM 8 воркеров + Horizon (supervisor) + artisan-команды при деплое
# (migrate, config:cache и т.п.) + root для healthcheck/диагностики.
max_connections = 80

# STAGE: ослабленная durability ради скорости.
# На prod должно быть flush_log_at_trx_commit=1 и sync_binlog=1.
# Тут потеря последней секунды транзакций допустима, зато в 2-3× быстрее IO.
innodb_flush_log_at_trx_commit = 2
sync_binlog = 0

# Медленные запросы — логировать всё дольше 1 сек
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

# Буферы для сортировок и временных таблиц (на воркер)
sort_buffer_size = 1M
read_rnd_buffer_size = 1M
tmp_table_size = 32M
max_heap_table_size = 32M

# Кодировка
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci
